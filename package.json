{
  "name": "hexa-giveaway",
  "version": "0.1.0",
  "private": true,
  "description": "Extension Twitch de giveaways basés sur la présence + app de notifications de live",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server/src/index.js",
    "test": "node --test \"server/test/*.test.js\"",
    "icons": "node scripts/gen-icons.js",
    "ext:zip": "node scripts/zip-extension.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "web-push": "^3.6.7"
  }
}
