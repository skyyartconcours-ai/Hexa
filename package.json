{
  "name": "hexa",
  "productName": "Hexa",
  "private": true,
  "version": "0.1.0",
  "description": "Hexa (LiveInk) — annotation d'écran en direct, magnifique et légère, pour créateurs",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:main": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --external:electron --outdir=dist-electron --out-extension:.js=.cjs --format=cjs",
    "app:dev": "npm run build:main && cross-env VITE_DEV_SERVER_URL=http://localhost:5173/ electron .",
    "app": "npm run build && npm run build:main && electron .",
    "spike": "npm run build:main && cross-env HEXA_SPIKE=1 electron ."
  },
  "dependencies": {
    "perfect-freehand": "^1.2.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "cross-env": "^7.0.3",
    "electron": "^37.2.0",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.0",
    "vite": "^6.3.5"
  }
}
