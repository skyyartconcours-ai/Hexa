{
  "name": "@hexa/type",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cinematic esports typography: metrics, SVG text rendering, VS marks, nameplates and legibility scoring",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "fonts/README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hexa/core": "workspace:*",
    "opentype.js": "^1.3.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "sharp": "^0.34.4",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
