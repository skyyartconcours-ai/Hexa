{
  "name": "@hexa/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared contracts, domain types and primitives for the Hexa thumbnail engine",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
