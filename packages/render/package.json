{
  "name": "@hexa/render",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The pixel engine: layer compositor, cinematic effect stack, procedural FX generators and film-grade colour pipeline",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "tsx scripts/preview.ts"
  },
  "dependencies": {
    "@hexa/core": "workspace:*",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
