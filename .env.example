# ─────────────────────────────────────────────────────────────
#  Hexa Roast — configuration
#  Copie ce fichier en `.env` et remplis les valeurs.
# ─────────────────────────────────────────────────────────────

# ── Twitch ───────────────────────────────────────────────────
# Cree une app sur https://dev.twitch.tv/console/apps
# Type de client : "Public"  (obligatoire pour le Device Code Flow)
# OAuth Redirect URL : http://localhost:3000 (non utilise, mais requis par le formulaire)
TWITCH_CLIENT_ID=
# Ton login Twitch en minuscules (ex: skyyart)
TWITCH_CHANNEL=

# ── Anthropic (generation des vannes) ────────────────────────
ANTHROPIC_API_KEY=
# claude-opus-5   -> meilleures vannes (defaut)
# claude-sonnet-5 -> bon compromis
# claude-haiku-4-5-> le moins cher / le plus rapide, vannes plus plates
ROAST_MODEL=claude-opus-5
# low | medium | high  (ignore sur haiku). low = rapide et suffisant ici.
ROAST_EFFORT=low

# ── Juge indépendant ─────────────────────────────────────────
# Un second modèle relit la vanne finale sans rien savoir d'autre : ni le
# profil du viewer, ni l'événement, ni les intentions de celui qui l'a écrite.
# Il répond "cette phrase peut-elle blesser : non / incertain / oui" et on jette
# sur "oui" ET sur "incertain".
# Coûte une fraction de centime et ~400 ms par vanne. Laisse-le allumé.
JUDGE_ENABLED=true
JUDGE_MODEL=claude-haiku-4-5

# ── TTS ──────────────────────────────────────────────────────
# fishaudio | elevenlabs | cartesia | none  ("none" = texte sans voix, pour tester)
#
#   fishaudio  : recommande. ~4-5x moins cher qu'ElevenLabs en FR, qualite au
#                moins equivalente, clonage de voix simple
#   elevenlabs : la reference historique, la plus chere
#   cartesia   : la plus basse latence (peu utile ici), tres bon marche
#
# Ne remplis que les cles du fournisseur choisi.
# Laisse "none" tant que tu n'as pas de cle : l'outil affichera les vannes en
# texte dans l'overlay au lieu d'echouer silencieusement a chaque sub.
TTS_PROVIDER=none

# Voix FR : https://fish.audio/discovery (le "reference_id" du modele de voix)
# Attention : facturation a l'octet UTF-8, un accent francais compte double.
FISHAUDIO_API_KEY=
FISHAUDIO_VOICE_ID=
FISHAUDIO_MODEL_ID=s2.1-pro
# 1.0 = normal. Monte a 1.05-1.1 pour une vanne plus punchy.
FISHAUDIO_SPEED=1.0

# Voix FR : https://elevenlabs.io/app/voice-library
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Voix FR : https://play.cartesia.ai/voices
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL_ID=sonic-3
# L'API Cartesia est versionnee par date ; on la fige volontairement.
CARTESIA_VERSION=2025-11-04

# ── Serveur local (overlay OBS + panneau de controle) ────────
PORT=4747

# ── Comportement de la session ───────────────────────────────
# Duree par defaut d'une session de roast, en minutes
SESSION_DEFAULT_MINUTES=30
# true  = chaque vanne part toute seule
# false = tu valides chaque vanne dans le panneau avant qu'elle passe (recommande au debut)
AUTO_PLAY=false
# Delai minimum entre deux vannes (secondes)
MIN_INTERVAL_SECONDS=8
# Taille max de la file d'attente
MAX_QUEUE=40
# Severite max toleree (1 = tres gentil, 5 = mechant). Au dessus, la vanne est jetee.
MAX_SEVERITY=3
# Ne pas re-roast le meme viewer avant N minutes
USER_COOLDOWN_MINUTES=20
# Une vanne validee mais jamais diffusee est jetee au bout de N secondes : au-dela
# elle n'est plus reliee au sub qui l'a declenchee, et elle sature la file.
PENDING_TTL_SECONDS=180
# Plafond de generations simultanees. Sans lui, un hype train lance 40 appels en
# parallele, prend un 429, et toutes les vannes du pic sont perdues.
MAX_CONCURRENT_GENERATIONS=3

# ── Sub gifts ────────────────────────────────────────────────
# Celui qui OFFRE est toujours roast : il a agi volontairement, et c'est le
# meilleur moment du segment.
# Celui qui RECOIT n'a rien fait — pas paye, pas choisi, pas forcement devant
# son ecran. C'est la seule categorie roastable sans avoir rien demande, alors
# qu'une fenetre a subs est justement ce qui declenche les vagues de gifts.
# none | limited   (limited = maximum GIFT_RECIPIENTS_MAX par vague de gifts)
GIFT_RECIPIENTS=none
GIFT_RECIPIENTS_MAX=3

# ── Historique de chat ───────────────────────────────────────
# Twitch ne fournit AUCUNE API d'historique de chat, quel que soit le niveau de
# permission du token. Deux sources :
#   1. le log en direct, a partir du 1er lancement (automatique)
#   2. `npm run backfill` : import du chat de tes VODs (retroactif)
# Nombre de jours de chat conserves
CHAT_RETENTION_DAYS=30
# Nombre de messages injectes dans le prompt pour personnaliser la vanne
PROFILE_SAMPLE_SIZE=25

# ── Optionnel : reposter la vanne dans le chat ───────────────
# Necessite le scope user:write:chat (demande automatiquement au login)
ECHO_IN_CHAT=false
