# Hexa configuration — copy to .env and fill in what you need.
# Everything here is OPTIONAL. With no keys at all, Hexa renders offline using
# the built-in procedural backplate provider.

# ── Vision sidecar (enables identity verification + high-quality cutouts) ────
# Start it with: ./services/vision/run.sh
HEXA_VISION_URL=http://127.0.0.1:8765

# ── Asset library location ──────────────────────────────────────────────────
HEXA_ASSETS=./assets/library

# ── Logging: silent | error | warn | info | debug | trace ───────────────────
HEXA_LOG=info

# ── AI backplate providers (backgrounds only — never faces) ─────────────────
# Configure any subset; `hexa providers` shows what is active.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
STABILITY_API_KEY=
REPLICATE_API_TOKEN=

# Preferred provider id, else Hexa picks the best configured one, else 'local'.
HEXA_AI_PROVIDER=local
