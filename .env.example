# Copie ce fichier en .env et remplis chaque valeur (voir README, section « Installation »).

# URL publique HTTPS du serveur, sans / à la fin
PUBLIC_URL=https://ton-serveur.example.com
PORT=8080
DB_PATH=./data/giveaway.db

# Longue chaîne aléatoire : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Ta chaîne Twitch
BROADCASTER_ID=
BROADCASTER_LOGIN=

# Application Twitch (dev.twitch.tv → Applications) — connexion + alerte « live démarré »
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Extension Twitch (dev.twitch.tv → Extensions → ton extension)
EXTENSION_CLIENT_ID=
# Extension Settings → Secret Keys (déjà en base64, colle-le tel quel)
EXTENSION_SECRET=
# Ton ID utilisateur Twitch (propriétaire de l'extension) ; par défaut = BROADCASTER_ID
EXTENSION_OWNER_ID=

# Secret de 10 à 100 caractères pour signer l'alerte « live démarré »
EVENTSUB_SECRET=

# Notifications : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ton-email@example.com
